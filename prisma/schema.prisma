datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  conversationMembers ConversationMember[]
  sentMessages        Message[]            @relation("SentMessages")
  initiatedCalls      Call[]               @relation("InitiatedCalls")
  receivedCalls       Call[]               @relation("ReceivedCalls")
  notifications       Notification[]
  blockedUsers        Block[]              @relation("BlockerRelation")
  blockedByUsers      Block[]              @relation("BlockedRelation")

  @@index([username])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  status         String       @default("sent") // "sent", "read"
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Call {
  id         String    @id @default(uuid())
  callerId   String
  caller     User      @relation("InitiatedCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)
  type       String    @default("audio") // "audio"
  status     String    @default("calling") // "calling", "ringing", "connected", "completed", "rejected", "missed", "cancelled", "failed"
  startedAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  duration   Int       @default(0) // in seconds
  createdAt  DateTime  @default(now())

  @@index([callerId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "missed_call", "message"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
